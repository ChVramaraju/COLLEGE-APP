# =============================================================
# backend/.env.example — Local Development Environment Template
# =============================================================
# Copy this file to backend/.env and fill in your values.
#   cp backend/.env.example backend/.env
#
# NEVER commit backend/.env to git — it is gitignored.
# On Railway: set these as environment variables in the dashboard.
#
# DATABASE_URL priority:
#   Railway Variables > .env file > (no default — app won't start)
# =============================================================

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
# Railway: copy from your Postgres service's "Connect" tab
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/smart_college_db

# JWT Secret Key — must be a long random string in production
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-in-production

# CORS — comma-separated list of allowed frontend origins
# Local dev defaults are already set in settings.py
# Production example:
# ALLOWED_ORIGINS=https://myapp.netlify.app,https://myapp.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
